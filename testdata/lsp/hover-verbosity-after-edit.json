        },
        "range": {
          "start": {
            "line": 1,
            "character": 0
          },
          "end": {
            "line": 1,
            "character": 5
          }
        },
        "canIncreaseVerbosityLevel": false
      }
    },
    {
      "method": "textDocument/didChange",
      "notification": true,
      "params": {
        "textDocument": {
          "uri": "{{ROOT_URI}}/main.ts",
          "version": 2
        },
        "contentChanges": [
          {
            "text": "const count: string = \"one\";\ncount;\n"
          }
        ]
      }
    },
    {
      "method": "textDocument/hover",
      "params": {
        "textDocument": {
          "uri": "{{ROOT_URI}}/main.ts"
        },
        "position": {
          "line": 1,
          "character": 2
        },
        "verbosityLevel": 0
      },
      "expected": {
        "contents": {
          "kind": "markdown",
          "value": "\n```typescript\nconst count: string\n```\n"
        },
        "range": {
          "start": {
            "line": 1,
            "character": 0
          },
          "end": {
            "line": 1,
            "character": 5
          }
        },
        "canIncreaseVerbosityLevel": false
      }
    }
  ],
  "oracle": {
